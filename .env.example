# Google Cloud / Vertex (Gemini 3.x and Gemini Embedding 2 are served on the "global" location)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=helenia-11f98
GOOGLE_CLOUD_LOCATION=global

BOXES_BUCKET=helenia-11f98-boxes
BOXES_EMBED_MODEL=gemini-embedding-2
BOXES_CHAT_MODEL=gemini-3.8-flash
BOXES_AGENT_SA=boxes-agent@helenia-11f98.iam.gserviceaccount.com

# Parallel Search API. Put the key here for local dev, or store it in Secret Manager
# as secret name PARALLEL_API_KEY and leave this blank.
PARALLEL_API_KEY=
# Verify the exact base URL against the Parallel Search API reference before relying on it.
PARALLEL_SEARCH_URL=https://api.parallel.ai/v1/search
