VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_GCP_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_GCP_PROJECT
VITE_FIREBASE_STORAGE_BUCKET=YOUR_GCP_PROJECT.firebasestorage.app
VITE_FIREBASE_APP_ID=1:YOUR_PROJECT_NUMBER:web:YOUR_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_PROJECT_NUMBER
# Base URL of the backend. Empty means same origin (Hosting rewrites /api to Cloud Run).
VITE_API_BASE=
