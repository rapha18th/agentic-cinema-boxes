rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every document lives under the owner's uid. A signed-in user can read
    // their own subtree and nothing else. All writes go through the backend
    // (Admin SDK), so clients are read-only here.
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
